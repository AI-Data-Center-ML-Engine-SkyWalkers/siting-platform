# Where the FastAPI backend lives. Empty = same origin (dev proxy or FastAPI serving the build).
VITE_API_BASE=
# live: always call the backend | sample: built-in sample data | auto: try the backend, fall back to sample
VITE_DATA_MODE=auto
# browser (normal) | memory (for embedding the app inside another page)
VITE_ROUTER=browser
# Mapbox public token (starts with pk.) from https://account.mapbox.com/access-tokens/
# Set it and the site finder uses satellite street maps with search; leave it empty for the hologram globe.
# Restrict the token to your app's URLs in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=
# Optional default style, e.g. mapbox://styles/mapbox/satellite-streets-v12
VITE_MAPBOX_STYLE=
