# Copy to .env and fill in what you have. Every key is optional:
# sources without a key are skipped, and the AI falls back to keyword rules.

APP_NAME=Groundwork
DATABASE_URL=sqlite:///./groundwork.db
CORS_ORIGINS=http://localhost:5173
# Identify your scraper honestly; some APIs ask for a contact address.
USER_AGENT=GroundworkBot/0.1 (sustainable data center siting research; contact: you@example.com)

# Background jobs: scheduled collectors and the Bluesky live stream
ENABLE_SCHEDULER=false
ENABLE_JETSTREAM=false

# ---- AI: Gemini first, Claude as fallback, keyword rules last ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_FALLBACK=gemini-embedding-001
EMBEDDING_DIM=768
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---- Sources ----
OPENSTATES_API_KEY=          # https://open.pluralpolicy.com/accounts/profile/
LEGISCAN_API_KEY=            # https://legiscan.com/legiscan (free: 10,000 queries/month)
MEDIACLOUD_API_KEY=          # https://search.mediacloud.org/
BLUESKY_HANDLE=              # e.g. yourteam.bsky.social
BLUESKY_APP_PASSWORD=        # Settings > Privacy and security > App passwords
REDDIT_CLIENT_ID=            # only after Reddit approves your app (Responsible Builder Policy)
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=nova,Virginia,arizona,phoenix,Atlanta,texas,Ohio,Columbus,Memphis,Louisiana,Indiana,Georgia
MASTODON_INSTANCE=mastodon.social
# Legistar councils to watch: client|county FIPS|state, comma separated.
# Check a client name first with: python -m app.cli probe-legistar <client>
LEGISTAR_CLIENTS=
# Extra RSS/Atom feeds (local papers, advocacy groups), comma separated
RSS_FEEDS=

# ---- Scoring integration (step 2 to step 3) ----
# mock: built-in sample sites | http: your ML service | python: import a function
SCORING_PROVIDER=mock
ML_SERVICE_URL=              # e.g. http://localhost:8001
ML_PYTHON_ENTRYPOINT=        # e.g. ml_model.rank:rank_sites

# Community re-ranking strengths (see docs/INTEGRATION.md)
RERANK_BETA_SENTIMENT=0.3
RERANK_BETA_INCENTIVE=0.1
RERANK_BETA_RESTRICTION=0.3
HALF_LIFE_DAYS=30

# ---- Alerts ----
ALERT_WEBHOOK_URL=           # Slack or Discord incoming webhook (optional)
